{
  "_comment": "semdev bootstrap config (M0 foundation). Brings up the shared runtime substrate: the service manager, the graph fact-store (graph-ingest/graph-query), and the rule engine (run-lifecycle pack), with the ExecutorRegistry advertising semdev tools live. The agentic EXECUTION layer (agentic-tools/agentic-loop/agentic-model/agentic-dispatch components + their JetStream streams) is deferred to the g11 mock journey, which configures and validates it end-to-end. The default sim input is disabled (no semdev factory). rules_files are repo-relative (run from repo root); path resolution is finalized with g11. VERSION DISCIPLINE: the framework stores this config in a versioned NATS KV and, on boot, IGNORES the file when its version equals the KV version (it syncs from KV) \u2014 so BUMP \"version\" on every content change, or boot against a fresh KV (task nats:reset / test:integration), or your edits silently do not take effect.",
  "version": "0.1.1",
  "platform": {
    "org": "c360",
    "id": "semdev-bootstrap",
    "type": "bootstrap",
    "region": "local",
    "instance_id": "semdev-001",
    "environment": "development"
  },
  "tier": "agentic",
  "nats": {
    "urls": [
      "nats://localhost:4222"
    ]
  },
  "streams": {},
  "model_registry": {
    "capabilities": {
      "coordinator": {
        "preferred": [
          "mock"
        ],
        "requires_tools": true
      },
      "developer": {
        "preferred": [
          "mock"
        ],
        "requires_tools": true
      },
      "reviewer": {
        "preferred": [
          "mock"
        ],
        "requires_tools": true
      }
    },
    "endpoints": {
      "mock": {
        "provider": "openai",
        "url": "http://mock-llm:8080/v1",
        "model": "mock-model",
        "supports_tools": true,
        "tool_format": "openai"
      }
    },
    "defaults": {
      "model": "mock"
    }
  },
  "services": {
    "service-manager": {
      "name": "service-manager",
      "enabled": true,
      "config": {}
    },
    "component-manager": {
      "name": "component-manager",
      "enabled": true,
      "config": {}
    },
    "metrics": {
      "name": "metrics",
      "enabled": true,
      "config": {
        "port": 9091,
        "path": "/metrics"
      }
    }
  },
  "components": {
    "graph-ingest": {
      "type": "processor",
      "name": "graph-ingest",
      "enabled": true,
      "config": {
        "ports": {
          "inputs": [
            {
              "name": "graph_mutations",
              "subject": "graph.mutation.>",
              "type": "nats",
              "description": "Triple add/remove mutations from semdev's agentic tools and rules"
            }
          ],
          "outputs": [
            {
              "name": "entity_states",
              "subject": "ENTITY_STATES",
              "type": "kv-write",
              "description": "Entity state KV bucket"
            }
          ]
        },
        "enable_hierarchy": true,
        "enforce_owner_lease": false
      }
    },
    "graph-query": {
      "type": "processor",
      "name": "graph-query",
      "enabled": true,
      "config": {
        "ports": {
          "inputs": [
            {
              "name": "query_requests",
              "subject": "graph.query.>",
              "type": "nats-request"
            }
          ],
          "outputs": []
        },
        "request_timeout": "30s",
        "max_traversal_depth": 5,
        "max_traversal_nodes": 100
      }
    },
    "rule": {
      "type": "processor",
      "name": "rule-processor",
      "enabled": true,
      "config": {
        "entity_watch_patterns": [
          "c360.>"
        ],
        "enable_graph_integration": true,
        "pack_id": "semdev",
        "rules_files": [
          "rules/run-lifecycle/01-offer-change-approval.json",
          "rules/run-lifecycle/02-resume-after-change-approval.json",
          "rules/run-lifecycle/03-park-awaiting-human.json",
          "rules/run-lifecycle/04-archive-change-loop-closer.json"
        ],
        "inline_rules": []
      }
    },
    "sim": {
      "type": "input",
      "name": "sim",
      "enabled": false
    }
  }
}