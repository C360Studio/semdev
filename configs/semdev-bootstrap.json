{
  "_comment": "semdev bootstrap config (M0). Brings up the shared runtime substrate: the service manager, the graph fact-store (graph-ingest/graph-query), the rule engine (run-lifecycle pack), AND the agentic EXECUTION plane (agentic-tools/agentic-loop/agentic-model/agentic-dispatch over the AGENT/TOOL/USER JetStream streams), with the ExecutorRegistry advertising semdev tools live. The model endpoint is the deterministic mock (model_registry.endpoints.mock) so a boot spends zero paid tokens; the g11 journey overrides its url to point at the in-process internal/mockllm loopback and drives the arc end-to-end. Assembly of the whole plane is health-proven by the boot smoke test (internal/boot/runtime_integration_test.go) and structurally pinned offline (test/conformance/agentic_plane_test.go). The M0 front door is the intake adapter publishing a coordinator agentic.TaskMessage to agent.task.coordinator (arriving in group 5); agentic-dispatch is present for the completion/reply path and semteams parity. The default sim input is disabled (no semdev factory). rules_files are repo-relative (resolved to absolute against this file's dir by boot.resolveRulePackPaths, CWD-independent). VERSION DISCIPLINE: the framework stores this config in a versioned NATS KV and, on boot, IGNORES the file when its version equals the KV version (it syncs from KV) \u2014 so BUMP \"version\" on every content change, or boot against a fresh KV (task nats:reset / test:integration), or your edits silently do not take effect.",
  "version": "0.16.2",
  "platform": {
    "org": "c360",
    "id": "semdev-bootstrap",
    "type": "bootstrap",
    "region": "local",
    "instance_id": "semdev-001",
    "environment": "development"
  },
  "tier": "agentic",
  "nats": {
    "urls": [
      "nats://localhost:4222"
    ]
  },
  "streams": {
    "AGENT": {
      "subjects": [
        "agent.>"
      ],
      "storage": "file",
      "max_age": "24h"
    },
    "TOOL": {
      "subjects": [
        "tool.>"
      ],
      "storage": "file",
      "max_age": "24h"
    },
    "USER": {
      "subjects": [
        "user.>"
      ],
      "storage": "file",
      "max_age": "1h"
    }
  },
  "model_registry": {
    "capabilities": {
      "coordinator": {
        "preferred": [
          "mock"
        ],
        "requires_tools": true
      },
      "developer": {
        "preferred": [
          "mock"
        ],
        "requires_tools": true
      },
      "reviewer": {
        "preferred": [
          "mock"
        ],
        "requires_tools": true
      }
    },
    "endpoints": {
      "mock": {
        "provider": "openai",
        "url": "http://mock-llm:8080/v1",
        "model": "mock-model",
        "supports_tools": true,
        "tool_format": "openai"
      }
    },
    "defaults": {
      "model": "mock"
    }
  },
  "services": {
    "service-manager": {
      "name": "service-manager",
      "enabled": true,
      "config": {}
    },
    "component-manager": {
      "name": "component-manager",
      "enabled": true,
      "config": {}
    },
    "metrics": {
      "name": "metrics",
      "enabled": true,
      "config": {
        "port": 9091,
        "path": "/metrics"
      }
    }
  },
  "components": {
    "graph-ingest": {
      "type": "processor",
      "name": "graph-ingest",
      "enabled": true,
      "config": {
        "ports": {
          "inputs": [
            {
              "name": "graph_mutations",
              "subject": "graph.mutation.>",
              "type": "nats",
              "description": "Triple add/remove mutations from semdev's agentic tools and rules"
            }
          ],
          "outputs": [
            {
              "name": "entity_states",
              "subject": "ENTITY_STATES",
              "type": "kv-write",
              "description": "Entity state KV bucket"
            }
          ]
        },
        "enable_hierarchy": true,
        "enforce_owner_lease": false
      }
    },
    "graph-query": {
      "type": "processor",
      "name": "graph-query",
      "enabled": true,
      "config": {
        "ports": {
          "inputs": [
            {
              "name": "query_requests",
              "subject": "graph.query.>",
              "type": "nats-request"
            }
          ],
          "outputs": []
        },
        "request_timeout": "30s",
        "max_traversal_depth": 5,
        "max_traversal_nodes": 100
      }
    },
    "rule": {
      "type": "processor",
      "name": "rule-processor",
      "enabled": true,
      "config": {
        "entity_watch_patterns": [
          "c360.>"
        ],
        "enable_graph_integration": true,
        "pack_id": "semdev",
        "rules_files": [
          "rules/coordinator/01-issue-intake-mint-run.json",
          "rules/coordinator/02-create-change-spawn.json",
          "rules/coordinator/03-validate-authored-change.json",
          "rules/agent-run/01-handoff-marker.json",
          "rules/agent-run/02-dispatched-to-executing.json",
          "rules/run-lifecycle/01-offer-change-approval.json",
          "rules/run-lifecycle/02-resume-after-change-approval.json",
          "rules/run-lifecycle/03-park-awaiting-human.json",
          "rules/run-lifecycle/04-archive-change-loop-closer.json",
          "rules/dev-from-task/01-anchor-run-for-dispatch.json",
          "rules/dev-from-task/02-rewake-coordinator-dev.json",
          "rules/dev-from-task/03-project-tasks.json",
          "rules/dev-from-task/04-dispatch-developer.json",
          "rules/dev-from-task/05-floors-trigger.json",
          "rules/dev-from-task/06a-route-advance.json",
          "rules/dev-from-task/06b-route-not-clean.json",
          "rules/dev-from-task/06e-route-not-clean-floor.json",
          "rules/dev-from-task/06c-route-retry.json",
          "rules/dev-from-task/06d-route-escalate.json",
          "rules/dev-from-task/07a-review-approved.json",
          "rules/dev-from-task/07b-review-retry.json",
          "rules/dev-from-task/07c-review-park.json",
          "rules/dev-from-task/07d-review-no-verdict.json",
          "rules/dev-from-task/08a-delivery-open-pr.json",
          "rules/dev-from-task/08b-delivery-park.json",
          "rules/sandbox/01-provision.json",
          "rules/sandbox/02-park-unprovable.json"
        ],
        "inline_rules": []
      }
    },
    "agentic-tools": {
      "type": "processor",
      "name": "agentic-tools",
      "enabled": true,
      "config": {
        "stream_name": "TOOL",
        "timeout": "10s",
        "allowed_tools": [
          "decide",
          "query_entity",
          "read_loop_result",
          "scratchpad",
          "ask_human",
          "create_change",
          "render_openspec",
          "write_change",
          "validate_change",
          "github_list_comments",
          "project_tasks",
          "provision_sandbox",
          "read_workspace",
          "read_diff",
          "apply_patch",
          "measure_task",
          "check_floors",
          "submit_review",
          "verify_artifact",
          "open_pr"
        ],
        "restricted_decide_actions": [],
        "ports": {
          "inputs": [
            {
              "name": "tool.execute",
              "type": "jetstream",
              "subject": "tool.execute.>",
              "stream_name": "TOOL",
              "required": true
            }
          ],
          "outputs": [
            {
              "name": "tool.result",
              "type": "jetstream",
              "subject": "tool.result.*",
              "stream_name": "TOOL",
              "required": true
            }
          ],
          "kv_read": [
            {
              "name": "entity_states",
              "type": "kv-read",
              "bucket": "ENTITY_STATES"
            }
          ]
        }
      }
    },
    "agentic-model": {
      "type": "processor",
      "name": "agentic-model",
      "enabled": true,
      "config": {
        "stream_name": "AGENT",
        "timeout": "30s",
        "retry": {
          "max_attempts": 3,
          "backoff": "exponential"
        },
        "ports": {
          "inputs": [
            {
              "name": "agent.request",
              "type": "jetstream",
              "subject": "agent.request.>",
              "stream_name": "AGENT",
              "required": true
            }
          ],
          "outputs": [
            {
              "name": "agent.response",
              "type": "jetstream",
              "subject": "agent.response.*",
              "stream_name": "AGENT",
              "required": true
            }
          ]
        }
      }
    },
    "agentic-loop": {
      "type": "processor",
      "name": "agentic-loop",
      "enabled": true,
      "config": {
        "max_iterations": 8,
        "timeout": "300s",
        "stream_name": "AGENT",
        "loops_bucket": "AGENT_LOOPS",
        "ports": {
          "inputs": [
            {
              "name": "agent.task",
              "type": "jetstream",
              "subject": "agent.task.*",
              "stream_name": "AGENT",
              "required": true
            },
            {
              "name": "agent.response",
              "type": "jetstream",
              "subject": "agent.response.>",
              "stream_name": "AGENT",
              "required": true
            },
            {
              "name": "tool.result",
              "type": "jetstream",
              "subject": "tool.result.>",
              "stream_name": "TOOL",
              "required": true
            },
            {
              "name": "agent.approval_response",
              "type": "jetstream",
              "subject": "agent.approval_response.*",
              "stream_name": "AGENT"
            }
          ],
          "outputs": [
            {
              "name": "agent.request",
              "type": "jetstream",
              "subject": "agent.request.*",
              "stream_name": "AGENT"
            },
            {
              "name": "tool.execute",
              "type": "jetstream",
              "subject": "tool.execute.*",
              "stream_name": "TOOL"
            },
            {
              "name": "agent.complete",
              "type": "jetstream",
              "subject": "agent.complete.*",
              "stream_name": "AGENT"
            },
            {
              "name": "agent.failed",
              "type": "jetstream",
              "subject": "agent.failed.*",
              "stream_name": "AGENT"
            },
            {
              "name": "agent.approval_pending",
              "type": "jetstream",
              "subject": "agent.approval_pending.*",
              "stream_name": "AGENT"
            }
          ],
          "kv_write": [
            {
              "name": "loops",
              "type": "kv-write",
              "bucket": "AGENT_LOOPS"
            },
            {
              "name": "trajectories",
              "type": "kv-write",
              "bucket": "AGENT_TRAJECTORIES"
            }
          ]
        }
      }
    },
    "agentic-dispatch": {
      "type": "processor",
      "name": "agentic-dispatch",
      "enabled": true,
      "config": {
        "default_role": "coordinator",
        "auto_continue": true,
        "default_tools": [
          "decide",
          "read_loop_result",
          "scratchpad",
          "query_entity"
        ],
        "stream_name": "USER",
        "ports": {
          "inputs": [
            {
              "name": "user.message",
              "type": "jetstream",
              "subject": "user.message.>",
              "stream_name": "USER",
              "required": true
            },
            {
              "name": "agent.complete",
              "type": "jetstream",
              "subject": "agent.complete.*",
              "stream_name": "AGENT",
              "required": true
            }
          ],
          "outputs": [
            {
              "name": "agent.task",
              "type": "jetstream",
              "subject": "agent.task.*",
              "stream_name": "AGENT"
            },
            {
              "name": "user.response",
              "type": "nats",
              "subject": "user.response.*"
            },
            {
              "name": "agent.approval_response",
              "type": "jetstream",
              "subject": "agent.approval_response.*",
              "stream_name": "AGENT"
            }
          ]
        },
        "permissions": {
          "view": ["*"],
          "submit_task": ["*"],
          "cancel_own": true,
          "cancel_any": [],
          "approve": ["*"]
        }
      }
    },
    "sim": {
      "type": "input",
      "name": "sim",
      "enabled": false
    }
  }
}